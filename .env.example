# Copy to .env and fill in. OAuth2 client credentials from the Alpaca Broker dashboard.
ALPACA_CLIENT_ID=
ALPACA_CLIENT_SECRET=
POSTGRES_DB=alpaca
POSTGRES_USER=alpaca
POSTGRES_PASSWORD=alpaca
# Optional overrides (defaults = sandbox)
# ALPACA_TOKEN_URL=https://authx.sandbox.alpaca.markets/v1/oauth2/token
# ALPACA_BROKER_URL=https://broker-api.sandbox.alpaca.markets
# ALPACA_MARKET_DATA_URL=https://data.sandbox.alpaca.markets
# 4-character correspondent code (sandbox funding via simulated incoming wire)
ALPACA_CORRESPONDENT=
